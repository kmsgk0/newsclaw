{
  "uid": "newsclaw-operations",
  "title": "NewsClaw 运行",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "技能调用量",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (increase(newsclaw_skill_calls_total[5m]))",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "技能错误率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (rate(newsclaw_skill_calls_total{result=\"failed\"}[5m])) / clamp_min(sum by (skill) (rate(newsclaw_skill_calls_total[5m])), 0.001)",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "接口 P95 与队列深度",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(newsclaw_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "接口 P95"
        },
        {
          "refId": "B",
          "expr": "newsclaw_queue_jobs{state=\"waiting\"}",
          "legendFormat": "等待任务"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "等待任务"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    }
  ]
}
