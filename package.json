{
  "name": "newsclaw",
  "private": true,
  "type": "module",
  "description": "NewsClaw personalized news reading platform",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "node scripts/checks/check.mjs",
    "check:repo": "node scripts/checks/check-repository.mjs",
    "check:specs": "openspec validate --all --strict --no-interactive",
    "check:commits": "node scripts/checks/check-commits.mjs",
    "check:security": "node scripts/checks/check-security.mjs",
    "test:checks": "node --test scripts/checks/test-checks.mjs",
    "test:security": "node --test scripts/checks/test-security.mjs",
    "dev": "tsx watch src/server/index.ts",
    "worker": "tsx src/server/worker.ts",
    "migrate": "tsx src/server/migrate.ts",
    "seed": "tsx src/server/seed.ts",
    "lint": "eslint src tests apitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:api": "node --import tsx --test --test-concurrency=1 apitest/cases/*.test.ts"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xyflow/react": "12.12.1",
    "bullmq": "6.7.1",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "fast-xml-parser": "5.12.0",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "lucide-react": "1.70.0",
    "mdast-util-from-markdown": "2.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "8.12.4",
    "zod": "4.6.7"
  }
}
